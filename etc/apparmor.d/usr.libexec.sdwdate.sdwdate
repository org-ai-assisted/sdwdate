## Confines the actual daemon entrypoint. sdwdate.service runs
## /usr/libexec/sdwdate/sdwdate directly (the /usr/bin/sdwdate wrapper is only an
## interactive leaprun shim). The service sets NoNewPrivileges=true, so helper
## transitions use additive profile STACKING (Cx -> &profile), never a discrete
## Px swap (which NNP denies).
/usr/libexec/sdwdate/sdwdate flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/bash>
  #include <abstractions/python>
  #include <abstractions/url_to_unixtime>
  #include <local/usr.libexec.sdwdate.sdwdate>

  capability sys_time,

  signal receive set=cont,
  signal receive set=term,
  ## The reaped child's stacked label is <child>//&<parent>, so each send peer
  ## must name the child first; a reversed order never matches and the signal is
  ## denied. The reapers (run_command for url_to_unixtime, kill_sclockadj for
  ## sclockadj) both call process.kill() == SIGKILL, so set=kill is REQUIRED; a
  ## denied kill leaves a hung fetch / running slew alive (kill_sclockadj even
  ## swallows the denial). set=term kept for a future graceful path.
  signal send set=term peer=/usr/bin/url_to_unixtime//&/usr/libexec/sdwdate/sdwdate,
  signal send set=kill peer=/usr/bin/url_to_unixtime//&/usr/libexec/sdwdate/sdwdate,
  signal send set=kill peer=/usr/libexec/sdwdate/sclockadj//&/usr/libexec/sdwdate/sdwdate,

  deny /usr/sbin/ldconfig rx,

  deny /etc/nsswitch.conf r,
  deny /etc/passwd r,
  /etc/sdwdate.d/ r,
  /etc/sdwdate.d/** r,
  /etc/tor/ r,
  /etc/tor/** r,
  /run/tor/control.authcookie r,
  /tmp/* mrw,
  /tmp/** mrw,
  /usr/lib/python3/dist-packages/sdwdate/timesanitycheck.py rix,
  /usr/libexec/helper-scripts/ r,
  /usr/libexec/helper-scripts/** r,
  /usr/libexec/helper-scripts/onion-time-pre-script rix,
  /usr/libexec/helper-scripts/settings_echo mrix,
  /usr/libexec/helper-scripts/tor_bootstrap_check.bsh mrix,
  /usr/libexec/helper-scripts/tor_bootstrap_check.py mrix,
  /usr/libexec/helper-scripts/tor_consensus_valid-after.py mrix,
  /usr/libexec/helper-scripts/tor_consensus_valid-until.py mrix,
  /usr/libexec/sdwdate/ r,
  /usr/libexec/sdwdate/sdwdate r,
  ## The daemon drives privileged time operations (anondate-set, clock jump,
  ## hwclock sync) through privleap. Required now that the daemon is actually
  ## confined: without these, leaprun exec is denied and sdwdate's tor/anondate
  ## preparation fails (verified end-to-end on a Kicksecure VM). Matches the
  ## systemcheck profile's privleap-client pattern.
  /{,usr/}bin/leaprun rix,
  /run/privleapd/pid r,
  /run/privleapd/comm r,
  ## sclockadj is the privileged CAP_SYS_TIME clock setter. Stack it into its own
  ## minimal profile (additive, NNP-safe) so a compromised daemon path cannot use
  ## the daemon's broader rules through it.
  /usr/libexec/sdwdate/sclockadj rmCx -> &/usr/libexec/sdwdate/sclockadj,
  ## url_to_unixtime parses untrusted network responses -- the highest-risk path.
  ## Stack it into its own profile (additive, NNP-safe) so the intersection strips
  ## the daemon's broader powers (sys_time, sclockadj exec, sdwdate file writes)
  ## from it; it keeps only what its own profile grants (network, python, ssl).
  /usr/bin/url_to_unixtime rmCx -> &/usr/bin/url_to_unixtime,
  /usr/sbin/anondate-get rUx,
  /usr/share/timesanitycheck/minimum_unixtime r,
  /usr/share/tor/tor-service-defaults-torrc r,
  /usr/share/tor/tor-service-defaults-torrc.anondist r,
  /usr/share/translations/sdwdate.yaml r,
  /var/lib/sdwdate/ rw,
  /var/lib/sdwdate/time-replay-protection-utc-humanreadable rw,
  /var/lib/sdwdate/time-replay-protection-utc-unixtime rw,
  /{,usr/local/}etc/torrc.d/ r,
  /{,usr/local/}etc/torrc.d/** r,
  /{,usr/}bin/ r,
  /{,usr/}bin/bash ix,
  /{,usr/}bin/cat mrix,
  /{,usr/}bin/dash mrix,
  /{,usr/}bin/date mrix,
  /{,usr/}bin/minimum-unixtime-show rix,
  /{,usr/}bin/mktemp mrix,
  /{,usr/}bin/ps rix,
  /{,usr/}bin/python3.9 rix,
  /{,usr/}bin/qubesdb-cmd rix,
  /{,usr/}bin/qubesdb-read rix,
  /{,usr/}bin/rm mrix,
  /{,usr/}bin/sdwdate r,
  /{,usr/}bin/sleep rix,
  /{,usr/}bin/timeout mrix,
  /{,usr/}bin/timesanitycheck rix,
  /{,usr/}bin/tor-circuit-established-check rix,
  /{,usr/}bin/uname rix,
  /{,usr/}bin/whoami rix,
  /{,usr/}bin/id rix,
  /{,usr/}bin/touch mrix,
  ## onion-time-pre-script and tor_bootstrap_check run these during preparation;
  ## the daemon needs exec of each or preparation cannot complete under enforce.
  /{,usr/}bin/wc mrix,
  /{,usr/}bin/grep mrix,
  /{,usr/}bin/sanitize-string rix,
  @{PROC}/ r,
  @{PROC}/*/stat r,
  @{PROC}/sys/kernel/osrelease r,
  @{PROC}/uptime r,
  @{PROC}/uptime r,
  ## TODO: 'owner' keyword needed?
  ## Was breaking 'touch /run/sdwdate/onion-time-script-after-boot'? (As run by onion-time-pre-script.)
  ## https://forums.whonix.org/t/sdwdate-broken-on-virtualbox-whonix/12800/2
  /run/sdwdate/ rw,
  /run/sdwdate/** rw,
  /run/anondate/ rw,
  /run/anondate/** rw,
  deny /var/lib/sdwdate-forbidden-temp/** mrwlk,
  owner /usr/lib/python3/dist-packages/sdwdate/__pycache__/ rw,
  owner /usr/lib/python3/dist-packages/sdwdate/__pycache__/** rw,
  owner @{PROC}/*/fd/ r,
  owner @{PROC}/*/mounts r,
  owner @{PROC}/*/status r,

}
