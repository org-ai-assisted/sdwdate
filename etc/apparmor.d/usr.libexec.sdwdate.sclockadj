#include <tunables/global>

/usr/libexec/sdwdate/sclockadj flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <local/usr.libexec.sdwdate.sclockadj>

  capability sys_time,

  /usr/libexec/sdwdate/sclockadj mr,

  signal receive set=kill peer=/usr/libexec/sdwdate/sdwdate,
}
