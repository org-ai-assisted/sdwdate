#include <tunables/global>

/usr/bin/url_to_unixtime flags=(attach_disconnected) {
  #include <abstractions/url_to_unixtime>

  ## The sdwdate daemon SIGTERMs this child via run_command's reaper; the
  ## stacked receiver must permit the receive or the signal is denied.
  signal receive set=term peer=/usr/libexec/sdwdate/sdwdate,

  # Site-specific additions and overrides. See local/README for details.
  #include <local/usr.bin.url_to_unixtime>
}
